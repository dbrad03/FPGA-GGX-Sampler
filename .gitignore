# --- Python ---
**/__pycache__/
*.pyc
.venv/

# --- cocotb / sim build ---
sim_build/
sim/sim_build/

# --- Vivado run artifacts (logs, journals, reports, checkpoints) ---
*.jou
*.log
*.out
*.rpt
*.dcp
*.wdb
*.pb
*.str
*.backup.*
.Xil/
xsim.dir/
sim/clockInfo.txt

# --- Generated Vivado project (regenerate with:
#     vivado -mode batch -source vivado/build_floorplan_project.tcl ) ---
vivado/ggx_floorplan/

# --- Generated ROM/mem (rebuilt by the cocotb tests' ensure_*_rom helpers) ---
*.mem

# --- Regression harness run directories (sim/harness.py pnr) ---
# The reports are per-run scratch; sim/timing_history.csv is the tracked record
# and sim/baselines/ is the tracked baseline. Both are deliberately NOT ignored.
sim/harness_runs/

# --- compiled benchmark binary (source bench/benchmark.cpp is tracked) ---
bench/benchmark

# --- local agent config (kept out of the public repo) ---
# NOTE: CONTEXT.md and CONTEXT-MAP.md are deliberately NOT ignored -- they are
# the project's domain glossary and its index, and docs/REFACTOR_PLAN.md +
# docs/adr/ depend on that vocabulary.
CLAUDE.md
AGENTS.md
docs/agents/
